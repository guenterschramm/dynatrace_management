ine1])) AND contains(lower(CmdLine), lower(AgentDetectionPattern[Matchers][cmdLine2])))\n    // Filter by matcher \"cmdLine1\" in command line arguments as this is one of the other possible matcher combinations for detecting standalone agents\n    OR (AgentDetectionPattern[Type] == \"Standalone\" AND isNull(ContainerImage) AND isNotNull(AgentDetectionPattern[Matchers][cmdLine1]) AND (arraySize(splitString(toString(AgentDetectionPattern[Matchers]), \":\")) - 1) == 1 AND contains(lower(CmdLine), lower(AgentDetectionPattern[Matchers][cmdLine1])))\n  // **************** ↓ Containerized agents matching ↓ ****************\n    // Filter by matchers \"image\" in container image and \"cmdLine1\" in command line arguments as this is one of the possible matcher combinations for detecting containerized agents\n    OR (AgentDetectionPattern[Type] == \"Container\" AND isNotNull(ContainerImage) AND isNotNull(AgentDetectionPattern[Matchers][image]) AND isNotNull(AgentDetectionPattern[Matchers][cmdLine1]) AND (arraySize(splitString(toString(AgentDetectionPattern[Matchers]), \":\")) - 1) == 2 AND contains(lower(ContainerImage), lower(AgentDetectionPattern[Matchers][image])) AND contains(lower(CmdLine), lower(AgentDetectionPattern[Matchers][cmdLine1])))\n    // Filter by matchers \"image\" in container image and \"processName\" in process name as this is one of the other possible matcher combinations for detecting containerized agents\n    OR (AgentDetectionPattern[Type] == \"Container\" AND isNotNull(ContainerImage) AND isNotNull(AgentDetectionPattern[Matchers][image]) AND isNotNull(AgentDetectionPattern[Matchers][processName]) AND (arraySize(splitString(toString(AgentDetectionPattern[Matchers]), \":\")) - 1) == 2 AND contains(lower(ContainerImage), lower(AgentDetectionPattern[Matchers][image])) AND contains(lower(EntityName), lower(AgentDetectionPattern[Matchers][processName])))\n    // Filter by matcher \"image\" in container image as this is one of the other possible matcher combinations for detecting containerized agents\n    OR (AgentDetectionPattern[Type] == \"Container\" AND isNotNull(ContainerImage) AND isNotNull(AgentDetectionPattern[Matchers][image]) AND (arraySize(splitString(toString(AgentDetectionPattern[Matchers]), \":\")) - 1) == 1 AND contains(lower(ContainerImage), lower(AgentDetectionPattern[Matchers][image])))\n  // **************** ↓ Code module agents matching ↓ ****************\n    // Filter by matchers \"image\" in container image and \"cmdLine1\" in command line arguments as this is the possible matcher combination for detecting code module agents\n    OR (AgentDetectionPattern[Type] == \"CodeModule\" AND isNotNull(AgentDetectionPattern[Matchers][cmdLine1]) AND (arraySize(splitString(toString(AgentDetectionPattern[Matchers]), \":\")) - 1) == 1 AND contains(lower(CmdLine), lower(AgentDetectionPattern[Matchers][cmdLine1])))\n  // Rename columns for better display\n  | fieldsAdd Vendor = AgentDetectionPattern[Vendor], Type = AgentDetectionPattern[Type], Purpose = AgentDetectionPattern[Purpose]\n  // Determine each agent's name based on its type and attributes as this information will be derived from different attributes depending on the agent type\n  | fieldsAdd AgentName = if(Type == \"Container\", ContainerImage, else: if(Type == \"CodeModule\", AgentDetectionPattern[Matchers][cmdLine1], else: EntityName))\n  // Deduplicate results per PGI while collecting distinct purposes covered by detected agents as several detection patterns could match for the same agent\n  | summarize Purpose = collectDistinct(Purpose, expand: true), AgentDetectionPatterns = collectDistinct(AgentDetectionPattern), by:{AgentName, Vendor, Type, EntityName, id, HostName, HostId, ServiceName, ServiceId, CmdLine, ContainerImage}\n  // Reorder fields for best UX\n  | fields Vendor, AgentName, Type, Purpose, EntityName, id, HostName, HostId, ServiceName, ServiceId, AgentDetectionPatterns, CmdLine, ContainerImage\n\n  \n// **************** ↑ Process Group Instance analysis to detect standalone and containerized agents ↑ ****************\n\n\n| append [\n  // Alternative agents detection by analysis of process group instance attributes\n  fetch dt.entity.process_group_instance\n  | limit 200000\n  // Select the PGI relevant attributes to enable the analysis\n  | fieldsAdd dt.entity.container_group_instance = belongs_to[dt.entity.container_group_instance], dt.entity.host = belongs_to[dt.entity.host], dt.entity.service = belongs_to[dt.entity.service]\n  | fields\n      EntityName     = entity.name,\n      id,\n      Metadata        = metadata,\n      ContainerImage  = entityAttr(dt.entity.container_group_instance, \"containerImageName\"),\n      HostName        = entityName(dt.entity.host),\n      HostId          = dt.entity.host,\n      ServiceName     = entityName(dt.entity.service),\n      ServiceId       = dt.entity.service,\n      contains\n  // Further prepare the data for analysis\n  | parse toString(Metadata), \"LD 'COMMAND_LINE_ARGS:' LD:CmdLine '\\\"' LD\"\n  // Add key to match and insert all records from the joinNested subquery below into each record from the PGI table\n  | fieldsAdd Match = true\n  // Insert the full list of agent detection patterns into each PGI table record, to make them available for the upcoming per-record analysis\n  | joinNested AgentDetectionPattern = [\n    // Load the patterns from the hidden variable\n    data record(PatternsRaw = toString(array($AgentDetectionPatterns)))\n    | parse PatternsRaw, \"JSON_ARRAY:PatternStrings\"\n    // Expand to one row per pattern to make this array of patterns 'AgentDetectionPattern' expandable right after the join\n    | expand PatternStrings\n    // Extract and format the data from each pattern to make it queryable\n    | parse PatternStrings, \"JSON:PatternObj\"\n    | fields PatternObj\n    | fieldsAdd\n        Vendor       = PatternObj[vendor],\n        Type         = PatternObj[type],\n        Purpose      = PatternObj[purpose],\n        Matchers     = PatternObj[matchers]\n    | fieldsAdd Match = true, Purpose = splitString(Purpose, \",\")\n    | fieldsRemove PatternObj\n  \n  \n  // **************** ↓ Process Libraries analysis to detect agent libraries ↓ ****************\n  \n  \n      | filter in(Vendor, $Vendor) AND in(Type, $Type) AND Type == \"CodeModule\" AND in(Purpose, $Purpose) AND in(Purpose, array(\"APM\", \"RUM\"))\n    ], on: Match\n    | fieldsRemove Match\n    // Expand each PGI table record by each agent detection pattern to make them ready for matching. Each output record must relate to a combo of entity and a single detection pattern.\n    | expand AgentDetectionPattern\n    // Expand each PGI table record by each of its libraries to be able to analyse them one by one\n    | expand softwareComponentId = asRecord(contains)[`dt.entity.software_component`] // This relationship retrieves a maximum 100 entities\n    | lookup [\n      fetch dt.entity.software_component, from: -15m\n      | fields entity.name, id\n    ],\n      sourceField:softwareComponentId,\n      lookupField:id,\n      executionOrder: leftFirst\n    // Filter the outcome by looking for matches. Those matches will represent libraries that matched against a specific detection pattern (alternative agent).\n    | filter\n    // **************** ↓ Code module agents matching ↓ ****************\n      // Filter by matcher \"library\" in loaded libraries' name as this is the possible matcher combination for detecting agent libraries\n      (AgentDetectionPattern[Type] == \"CodeModule\" AND isNotNull(AgentDetectionPattern[Matchers][library]) AND (arraySize(splitString(toString(AgentDetectionPattern[Matchers]), \":\")) - 1) == 1 AND contains(lower(lookup.entity.name), lower(AgentDetectionPattern[Matchers][library])))\n    // Rename columns for better display\n    | fieldsAdd Vendor = AgentDetectionPattern[Vendor], Type = AgentDetectionPattern[Type], Purpose = AgentDetectionPattern[Purpose]\n    // Determine each agent's name based on its type and attributes as this information will be derived from different attributes depending on the agent type\n    | fieldsAdd AgentName = lookup.entity.name\n    // Deduplicate results per PGI while collecting distinct purposes covered by detected agents as several detection patterns could match for the same agent\n    | summarize Purpose = collectDistinct(Purpose, expand: true), AgentDetectionPatterns = collectDistinct(AgentDetectionPattern), by:{AgentName, Vendor, Type, EntityName, id, HostName, HostId, ServiceName, ServiceId, ContainerImage, Library = lookup.entity.name}\n    // Reorder fields for best UX\n    | fields Vendor, AgentName, Type, Purpose, EntityName, id, HostName, HostId, ServiceName, ServiceId, AgentDetectionPatterns, ContainerImage, Library\n  \n  \n  // **************** ↑ Process Libraries analysis to detect agent libraries ↑ ****************\n\n]\n\n| summarize count()",
