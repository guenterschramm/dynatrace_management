tern to make them ready for matching. Each output record must relate to a combo of a user event and a single detection pattern.\n  | expand AgentDetectionPattern\n  // Filter the outcome by looking for matches. Those matches will represent user events that matched against a specific detection pattern (alternative agent).\n  | filter\n  // **************** ↓ JS agents matching ↓ ****************\n    // Filter by matcher \"requestUrl\" in user events full URL as this is one of the possible matcher combinations for detecting frontend agents\n    (AgentDetectionPattern[Type] == \"JS\" AND isNotNull(AgentDetectionPattern[Matchers][requestUrl]) AND (arraySize(splitString(toString(AgentDetectionPattern[Matchers]), \":\")) - 1) == 1 AND contains(lower(url.full), lower(AgentDetectionPattern[Matchers][requestUrl])))\n    // Filter by matcher \"requestDomain\" in user events full domain as this is one of the other possible matcher combinations for detecting frontend agents\n    OR (AgentDetectionPattern[Type] == \"JS\" AND isNotNull(AgentDetectionPattern[Matchers][requestDomain]) AND (arraySize(splitString(toString(AgentDetectionPattern[Matchers]), \":\")) - 1) == 1 AND contains(lower(url.domain), lower(AgentDetectionPattern[Matchers][requestDomain])))\n  // Rename columns for better display\n  | fieldsAdd Vendor = AgentDetectionPattern[Vendor], Type = AgentDetectionPattern[Type], Purpose = AgentDetectionPattern[Purpose]\n  // Define defaut RUM JS agent name as it can't be dynamically extracted from attributes\n  | fieldsAdd AgentName = \"RUM JS agent\"\n  | summarize count(), AgentDetectionPatterns = collectDistinct(AgentDetectionPattern), by:{Vendor, AgentName, EntityName, id, Type, Purpose}\n  | fields Vendor, AgentName, EntityName, id, Type, Purpose, AgentDetectionPatterns\n]\n\n| summarize count(), by:{Type}\n| sort `count()` DESC",
