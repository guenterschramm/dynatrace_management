          "input": "export default async function () {\n  // Define detection patterns for each vendor's agents\n  // cmdLine2 is optional and combines with AND logic with cmdLine1 to refine the matching criteria\n  // Rules are checked from top to bottom and only the first rule that matches will be triggered for each process group instance\n  // The most generic rules must be at the bottom, while the most specific at the top\n  const agents = [\n    // ---------- Datadog ----------\n    {vendor:'Datadog',          type:'Standalone',    purpose:'APM',                                 matchers: { processName:'trace-agent', cmdLine1:'datadog' } },\n    {vendor:'Datadog',          type:'Standalone',    purpose:'APM',                                 matchers: { cmdLine1:'trace-agent', cmdLine2:'datadog' } },\n    {vendor:'Datadog',          type:'Standalone',    purpose:'Infra',                               matchers: { cmdLine1:'process-agent', cmdLine2:'datadog' } },\n    {vendor:'Datadog',          type:'Standalone',    purpose:'Network,Security',                    matchers: { cmdLine1:'system-probe', cmdLine2:'datadog' } },\n    {vendor:'Datadog',          type:'Standalone',    purpose:'Infra,Logs,Security,Network',         matchers: { cmdLine1:'datadog-agent' } },\n    {vendor:'Datadog',          type:'Container',     purpose:'APM',                                 matchers: { image:'datadog/agent', cmdLine1:'trace-agent' } },\n    {vendor:'Datadog',          type:'Container',     purpose:'Infra,Logs,Security,Network',         matchers: { image:'datadog/agent' } },\n    {vendor:'Datadog',          type:'Container',     purpose:'Infra,Logs',                          matchers: { image:'datadog/cluster-agent' } },\n    {vendor:'Datadog',          type:'CodeModule',    purpose:'APM,AI',                              matchers: { cmdLine1:'-javaagent:dd-java-agent' } },\n    {vendor:'Datadog',          type:'CodeModule',    purpose:'APM,AI',                              ma