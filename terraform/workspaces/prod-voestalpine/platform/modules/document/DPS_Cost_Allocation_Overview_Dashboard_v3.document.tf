          "query": "fetch dt.system.events\n| filter event.kind == \"BILLING_USAGE_EVENT\"\n| filterOut event.type == \"Traces - Ingest \u0026 Process\" //traces ingest needs special handling\n| filterOut event.type == \"Metrics - Ingest \u0026 Process\" //metrics ingest needs special handling\n| filter in(event.type, {$Capability})\n| dedup event.id, event.type\n| fieldsAdd costallocation = if($CostAllocation==\"costcenter\",dt.cost.costcenter, else: dt.cost.product)\n| fieldsAdd costallocation = if(isNull(costallocation), $unassigned, else: costallocation)\n| fieldsRemove dt.cost.costcenter, dt.cost.product\n| expand costallocation\n| fieldsAdd filter = coalesce(costallocation[key], costallocation)\n| filter in(filter, {$Filter}) or isNull(filter)\n| fieldsAdd billed_bytes = coalesce(costallocation[billed_bytes], billed_bytes)\n| fieldsAdd usage = coalesce(\n    billed_host_hours, //Infra, F\u0026D\n    billed_gibibyte_hours, //Fullstack, Runtime Application Protection, Runtime Vulnerability Analytics\n    toDouble(billed_bytes) / (1024*1024*1024), //ALL I/R/Q\n    billed_invocations, //AppEngine\n    ingested_bytes, //Traces I\n    billed_sessions, //RUM sessions\n    billed_replay_sessions, //rum replay sessions\n    billed_property_sessions, //rum properties\n    billed_pod_hours, //k8s platform monitoring\n    billed_container_hours, //Code Monitoring\n    billed_synthetic_action_count, //Browser Monitor\n    billed_http_request_count, //HTTP Monitor\n    billed_msu_hours, //Mainframe\n    1 //workflow count\n    )\n| fieldsAdd usage = if(contains(event.type,\"Retain\"),usage / 24, else: usage)\n| fieldsAdd usage.start = if(isNull(usage.start), timestamp, else: usage.start)\n| makeTimeseries interval: 15m, time: usage.start, nonempty:false, by:{filter, event.type },{\n  usage = sum(usage),\n  start = start()\n}\n// THIS IS JUST FOR TRACES INGEST NORMALIZATION -----\u003e\n| append [\n      fetch dt.system.events\n      | filter event.kind == \"BILLING_USAGE_EVENT\" and event.type == \"Traces - Ingest \u0026 Process\"\n      | filter in(event.type, {$Capability})\n      | fieldsAdd costallocation = if($CostAllocation==\"costcenter\",dt.cost.costcenter, else: dt.cost.product)\n      | fieldsRemove dt.cost.costcenter, dt.cost.product\n      | fieldsAdd filter = costallocation\n      | filter in(filter, {$Filter}) or isnull(filter)\n      | fieldsKeep usage.start, licensing_type, ingested_bytes, costallocation, event.id\n      | dedup event.id\n      | fieldsAdd licensing_type = if(in(licensing_type, {\n        \"otlp-trace-ingest\", \"serverless\"}), \"other\", else: licensing_type)\n\n      | fieldsAdd adaptive_volume = if(licensing_type == \"fullstack-adaptive\", ingested_bytes)\n      | fieldsAdd fixed_rate_volume = if(licensing_type == \"fullstack-fixed-rate\", ingested_bytes)\n      | fieldsAdd other_volume = if(licensing_type == \"other\", ingested_bytes)\n\n      | fieldsAdd costallocation = if(isNull(costallocation), $unassigned, else: costallocation)\n\n      | makeTimeseries interval: 15m, time: usage.start, by: {\n        costallocation}, nonempty: true, {\n        adaptive_volume = sum(adaptive_volume, default: 0),\n        fixed_rate_volume = sum(fixed_rate_volume, default: 0),\n        other_volume = sum(other_volume, default: 0),\n        start = start()\n      } \n\n        // calculate included volume per costcenter and join with trace-ingest usage\n      | join [\n          fetch dt.system.events, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) + 10min\n          | filter event.kind == \"BILLING_USAGE_EVENT\"\n          | filter event.type == \"Full-Stack Monitoring\"\n          | fieldsAdd cap_type = \"Traces - Ingest \u0026 Process\"\n          | filter in(cap_type, {$Capability}) //only query if trace ingest selected\n          | dedup event.id, event.type\n          | fieldsAdd costallocation = if($CostAllocation==\"costcenter\",dt.cost.costcenter, else: dt.cost.product)\n          | fieldsRemove dt.cost.costcenter, dt.cost.product\n          | fieldsKeep usage.start, billed_gibibyte_hours, costallocation, event.id\n          | makeTimeseries {\n            billed = sum(billed_gibibyte_hours, default: 0) }, by: {\n            costallocation }, time: usage.start, interval: 15m\n          | summarize by: {\n            timeframe, interval }, {\n            total = sum(billed[]), r = collectArray(record(costallocation, billed)) }\n          | expand r\n          | fieldsFlatten r, fields: {\n            costallocation, billed }\n          | fieldsAdd ratio = iCollectArray(coalesce((billed)[] / total[], 0.0))\n          | fields timeframe, interval, costallocation, ratio, billed, total\n          | join [\n              timeseries interval: 15m, union: true, nonempty: true, bucket: {\"default_metrics\"}, {\n                included_volume = max(dt.billing.traces.maximum_included_fullstack_volume_per_minute, default: 0),\n                configured_volume = max(dt.billing.traces.maximum_configured_fullstack_volume_per_minute, default: 0)\n              }\n              | fieldsAdd interval_in_minutes = toLong(interval) / 60000000000\n              | fieldsAdd extra_ingest_on = configured_volume[] \u003e included_volume[]\n              | fieldsAdd included_volume = interval_in_minutes * if(isNull(configured_volume[]), null, else: included_volume[])\n          \n          ], on: {\n            timeframe, interval }, fields: {\n            included_volume, extra_ingest_on }\n          | fieldsAdd included_volume_costallocation = included_volume[] * ratio[]\n          | fieldsAdd costallocation = if(isNull(costallocation), \"unassigned\", else: costallocation)\n          /**/\n      ], on: {\n         interval, costallocation }, kind: outer, prefix: \"included.\"\n       | fieldsAdd timeframe = coalesce(timeframe, included.timeframe)\n       | fieldsAdd interval = coalesce(interval, included.interval)\n       | fieldsAdd costallocation = coalesce