          "description": "",
          "query": "fetch dt.system.events\n| filter event.kind == \"BILLING_USAGE_EVENT\"\n| filterOut event.type == \"Traces - Ingest \u0026 Process\" //traces ingest needs special handling\n| filterOut event.type == \"Metrics - Ingest \u0026 Process\" //metrics ingest needs special handling\n| filter in(event.type, {$Capability})\n| dedup event.id, event.type\n| fieldsAdd costallocation = if($CostAllocation==\"costcenter\",dt.cost.costcenter, else: dt.cost.product)\n| fieldsAdd costallocation = if(isNull(costallocation), $unassigned, else: costallocation)\n| fieldsRemove dt.cost.costcenter, dt.cost.product\n| expand costallocation\n| fieldsAdd filter = coalesce(costallocation[key], costallocation)\n| filter in(filter, {$Filter}) or isNull(filter)\n| fieldsAdd billed_bytes = coalesce(costallocation[billed_bytes], billed_bytes)\n| fieldsAdd usage = coalesce(\n    billed_host_hours, //Infra, F\u0026D\n    billed_gibibyte_hours, //Fullstack, Runtime Application Protection, Runtime Vulnerability Analytics\n    toDouble(billed_bytes) / (1024*1024*1024), //ALL I/R/Q\n    billed_invocations, //AppEngine\n    ingested_bytes, //Traces I\n    billed_sessions, //RUM sessions\n    billed_replay_sessions, //rum replay sessions\n    billed_property_sessions, //rum properties\n    billed_pod_hours, //k8s platform monitoring\n    billed_container_hours, //Code Monitoring\n    billed_synthetic_action_count, //Browser Monitor\n    billed_http_request_count, //HTTP Monitor\n    billed_msu_hours, //Mainframe\n    1 //workflow count\n    )\n| fieldsAdd usage = if(contains(event.type,\"Retain\"),usage / 24, else: usage)\n| fieldsAdd usage.start = if(isNull(usage.start), timestamp, else: usage.start)\n| makeTimeseries interval: 15m, time: usage.start, nonempty:false, by:{filter, event.type },{\n  usage = sum(usage),\n  start = start()\n}\n// THIS IS JUST FOR TRACES INGEST NORMALIZATION -----\u003e\n| append [\n      fetch dt.system.events\n      | filter event.kind == \"BILLING_USAGE_EVENT\" and event.type == \"Traces - Ingest \u0026 Process\"\n      | filter in(event.type, {$Capability})\n      | fieldsAdd costallocation = if($CostAllocation==\"costcenter\",dt.cost.costcenter, else: dt.cost.product)\n      | fieldsRemove dt.cost.costcenter, dt.cost.product\n      | fieldsAdd filter = costallocation\n      | filter in(filter, {$Filter}) or isnull(filter)\n      | fieldsKeep usage.start, licensing_type, ingested_bytes, costallocation, event.id\n      | dedup event.id\n      | fieldsAdd licensing_type = if(in(licensing_type, {\n        \"otlp-trace-ingest\", \"serverless\"}), \"other\", else: licensing_type)\n\n      | fieldsAdd adaptive_volume = if(licensing_type == \"fullstack-adaptive\", ingested_bytes)\n      | fieldsAdd fixed_rate_volume = if(licensing_type == \"fullstack-fixed-rate\", ingested_bytes)\n      | fieldsAdd other_volume = if(licensing_type == \"other\", ingested_bytes)\n\n      | fieldsAdd costallocation = if(isNull(costallocation), $unassigned, else: costallocation)\n\n      | makeTimeseries interval: 15m, time: usage.start, by: {\n        costallocation}, nonempty: true, {\n        adaptive_volume = sum(adaptive_volume, default: 0),\n        fixed_rate_volume = sum(fixed_rate_volume, default: 0),\n        other_volume = sum(other_volume, default: 0),\n        start = start()\n      } \n\n        // calculate included volume per costcenter and join with trace-ingest usage\n      | join [\n          fetch dt.system.events, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) + 10min\n          | filter event.kind == \"BILLING_USAGE_EVENT\"\n          | filter event.type == \"Full-Stack Monitoring\"\n          | fieldsAdd cap_type = \"Traces - Ingest \u0026 Process\"\n          | filter in(cap_type, {$Capability}) //only query if trace ingest selected\n          | dedup event.id, event.type\n          | fieldsAdd costallocation = if($CostAllocation==\"costcenter\",dt.cost.costcenter, else: dt.cost.product)\n          | fieldsRemove dt.cost.costcenter, dt.cost.product\n          | fieldsKeep usage.start, billed_gibibyte_hours, costallocation, event.id\n          | makeTimeseries {\n            billed = sum(billed_gibibyte_hours, default: 0) }, by: {\n            costallocation }, time: usage.start, interval: 15m\n          | summarize by: {\n            timeframe, interval }, {\n            total = sum(billed[]), r = collectArray(record(costallocation, billed)) }\n          | expand r\n          | fieldsFlatten r, fields: {\n            costallocation, billed }\n          | fieldsAdd ratio = iCollectArray(coalesce((billed)[] / total[], 0.0))\n          | fields timeframe, interval, costallocation, ratio, billed, total\n          | join [\n              timeseries interval: 15m, union: true, nonempty: true, bucket: {\"default_metrics\"}, {\n                included_volume = max(dt.billing.traces.maximum_included_fullstack_volume_per_minute, default: 0),\n                configured_volume = max(dt.billing.traces.maximum_configured_fullstack_volume_per_minute, default: 0)\n              }\n              | fieldsAdd interval_in_minutes = toLong(interval) / 60000000000\n              | fieldsAdd extra_ingest_on = configured_volume[] \u003e included_volume[]\n              | fieldsAdd included_volume = interval_in_minutes * if(isNull(configured_volume[]), null, else: included_volume[])\n          \n          ], on: {\n            timeframe, interval }, fields: {\n            included_volume, extra_ingest_on }\n          | fieldsAdd included_volume_costallocation = included_volume[] * ratio[]\n          | fieldsAdd costallocation = if(isNull(costallocation), \"unassigned\", else: costallocation)\n          /**/\n      ], on: {\n         interval, costallocation }, kind: outer, prefix: \"included.\"\n       | fieldsAdd timeframe = coalesce(timeframe, included.timeframe)\n       | fieldsAdd interval = coalesce(interval, included.interval)\n       | fieldsAdd costallocation = coalesce(costallocation, included.costallocation)\n      | join [\n      //this creates an array of 0 with the correct length based on timeframe\n        data\n          record(a = 0)\n          | makeTimeseries empty_included = avg(a, default: 0), interval: 15min, nonempty:true, time: now()\n      ], on: { interval }, fields: { empty_included}, kind: outer\n      //this creates an array of false with the correct length based on timeframe\n      | join [\n        data\n          record(a = 0)\n          | makeTimeseries empty_included = avg(a, default: 0), interval: 15min, nonempty:true, time: now()\n          | expand empty_included\n          | fieldsAdd all_false = empty_included==1\n          | summarize all_false = collectArray(all_false), by: interval\n      ], on: { interval }, fields: { all_false}\n      //In cases where there's a costallocation in our BUE's but not in the included, set extra_ingest_on to false for each interval\n      | fieldsAdd\n          extra_ingest_on =\n              if(exists(included.extra_ingest_on) and isNotNull(included.extra_ingest_on), included.extra_ingest_on,\n                else: all_false)\n      //We'll use this one to slice the others down to size\n      | fieldsAdd adaptive_volume = coalesce(iCollectArray(coalesce(adaptive_volume[], 0)), empty_included)\n      //Get rid of nulls, and make sure we're keeping only as many items as match our \"volume\"\n      | fieldsAdd included_volume_costallocation = arraySlice(coalesce(iCollectArray(coalesce(included.included_volume_costallocation[], 0)), empty_included), to: arraySize(adaptive_volume))\n      //Replace nulls with 0\n      | fieldsAdd fixed_rate_volume = coalesce(iCollectArray(coalesce(fixed_rate_volume[], 0)), empty_included)\n      | fieldsAdd other_volume = coalesce(iCollectArray(coalesce(other_volume[], 0)), empty_included)\n      | fieldsKeep timeframe, interval, costallocation, adaptive_volume, fixed_rate_volume, other_volume,\n          included_volume_costallocation, extra_ingest_on, empty_included, start\n     // calculate fullstack trace-ingest usage per costcenter\n     | fieldsAdd included_volume_costallocation = arraySlice(included_volume_costallocation, to: arraySize(adaptive_volume)) //Since we're looking into the future with included, cut off any \"extra\"\n     | fieldsAdd license_remaining = included_volume_costallocation[] - adaptive_volume[]\n     | fieldsAdd license_remaining = if(license_remaining[] \u003e 0, license_remaining[], else: 0)\n     | fieldsAdd extra_ingest_on = arraySlice(extra_ingest_on, to: arraySize(adaptive_volume)) //Depending on time frame, we can end up with an extra value here\n     | fieldsAdd\n          billable_fullstack =\n              if(isNull(included_volume_costallocation[]), 0,\n                else: if(extra_ingest_on[], adaptive_volume[] + fixed_rate_volume[] - included_volume_costallocation[],\n                  else: fixed_rate_volume[] - license_remaining[]))\n\n      | fieldsAdd billable_fullstack = if(billable_fullstack[] \u003e 0, billable_fullstack[], else: 0)\n\n      | summarize {\n        total_included = sum(included_volume_costallocation[]),\n        total_adaptive = sum(adaptive_volume[]),\n        total_fixed_rate = sum(fixed_rate_volume[]),\n        total_fullstack_to_allocate = sum(billable_fullstack[]),\n        per_costallocation = collectArray(record(extra_ingest_on, billable_fullstack, billable_other = other_volume, costallocation, included_volume_costallocation, start))},\n        by: { interval }\n      | expand per_costallocation\n      | fieldsFlatten per_costallocation\n      | fieldsRemove per_costallocation\n\n      | fieldsAdd total_license_remaining = total_included[] - total_adaptive[]\n      | fieldsAdd total_license_remaining = if(total_license_remaining[] \u003e 0, total_license_remaining[], else: 0)\n      | fieldsAdd\n          total_applicable_fullstack =\n              if(isNull(per_costallocation.included_volume_costallocation), 0,\n                else: if(per_costallocation.extra_ingest_on[], total_adaptive[] + total_fixed_rate[] - total_included[],\n                  else: total_fixed_rate[] - total_license_remaining[]))\n      | fieldsAdd total_billable_fullstack = if(total_applicable_fullstack[] \u003e 0, total_applicable_fullstack[], else: 0)\n\n      | fieldsAdd\n          distributed_fullstack =\n              if(total_fullstack_to_allocate[] \u003c= 0, 0,\n                else: per_costallocation.billable_fullstack[] / total_fullstack_to_allocate[] * total_billable_fullstack[])\n      // filter out  entry if the included was not fetched\n      | fieldsAdd\n          adjusted_billable_total_per_costallocation =\n              per_costallocation.billable_other[] + toDouble(distributed_fullstack[])\n     | filterOut isNull(adjusted_billable_total_per_costallocation) or isNull(per_costallocation.start) or IsNull(per_costallocation.costallocation)\n     | fields interval, costallocation = per_costallocation.costallocation, adjusted_billable_total_per_costallocation, start=per_costallocation.start\n     | fieldsAdd event.type =\"Traces - Ingest \u0026 Process\"\n     | fieldsAdd filter = costallocation\n\n] \n| fieldsAdd traces_usage = adjusted_billable_total_per_costallocation[] / (1024*1024*1024)\n// \u003c---------THIS IS JUST FOR TRACES INGEST NORMALIZATION\n\n// THIS IS JUST FOR METRICS INGEST NORMALIZATION -----\u003e\n| append [\n      fetch dt.system.events, from: toTimestamp($dt_timeframe_from) + 4h, to: toTimestamp($dt_timeframe_to) + 4h\n      | filter event.kind == \"BILLING_USAGE_EVENT\" and event.type == \"Metrics - Ingest \u0026 Process\"\n      | filter in(event.type, {$Capability})\n      | dedup event.id, event.type\n      | fieldsAdd costallocation = if($CostAllocation==\"costcenter\",dt.cost.costcenter, else: dt.cost.product)\n      | fieldsRemove dt.cost.costcenter, dt.cost.product\n      | expand costallocation\n      | fieldsFlatten costallocation\n      | fields {\n        usage.start,\n        costallocation = if(isNull(costallocation.key), $unassigned, else: costallocation.key),\n        data_points = toLong(costallocation.data_points),\n        monitoring_source = if(monitoring_source == \"fullstack\" or monitoring_source == \"infrastructure\", monitoring_source, else: \"other\")\n      }\n      | summarize {\n        data_points = toLong(sum(data_points))\n      }, by: {\n        usage.start,\n        costallocation,\n        monitoring_source\n      }\n      | join [\n          fetch dt.system.events, from: toTimestamp($dt_timeframe_from), to: toTimestamp($dt_timeframe_to) + 1h\n          | filter event.kind == \"BILLING_USAGE_EVENT\" and in(event.type, { \"Full-Stack Monitoring\", \"Infrastructure Monitoring\" })\n          | fieldsAdd cap_type = \"Metrics - Ingest \u0026 Process\"\n          | filter in(cap_type, {$Capability}) //only query if metrics ingest selected\n          | dedup event.id, event.type\n          | fieldsAdd costallocation = if($CostAllocation==\"costcenter\",dt.cost.costcenter, else: dt.cost.product)\n          | fields {\n            usage.start,\n            costallocation = if(isNotNull(costallocation), costallocation, else: $unassigned),\n            billed_value = coalesce(if(exists(billed_gibibyte_hours), billed_gibibyte_hours, else: null), if(exists(billed_host_hours), billed_host_hours, else: null)),\n            monitoring_source = if(event.type == \"Full-Stack Monitoring\", \"fullstack\", else: if(event.type == \"Infrastructure Monitoring\", \"infrastructure\"))\n          }\n          | summarize {\n            billed = sum(billed_value)\n          }, by: {\n            usage.start,\n            costallocation,\n            monitoring_source\n          }\n          | fields {\n            usage.start,\n            costallocation,\n            monitoring_source,\n            billed,\n            included_usage =  billed * 4 * if(monitoring_source == \"fullstack\", 900, else: if(monitoring_source == \"infrastructure\", 1500, else: 0))\n          }\n      ], on: { usage.start, costallocation, monitoring_source }, kind:leftOuter, fields: { included_usage }\n      | fieldsAdd included_usage = if(isNotNull(included_usage), included_usage, else: 0)\n      | fieldsAdd billable = if(data_points \u003e included_usage, data_points - included_usage, else: 0)\n      | summarize {\n        data_points_total = sum(data_points),\n        included_total = sum(included_usage),\n        billable_per_costallocation_total = sum(billable),\n        rec = collectArray(record(costallocation, billable, included_usage))\n      }, by: {\n        usage.start,\n        monitoring_source\n      }\n      | fieldsAdd actual_billable_total = if(data_points_total \u003e included_total, data_points_total - included_total, else: 0)\n      | expand rec\n      | fieldsAdd ratio_for_cost_allocation = rec[billable] / billable_per_costallocation_total\n      | fieldsAdd charged_per_costcenter = ratio_for_cost_allocation * actual_billable_total\n      | fields usage = charged_per_costcenter, usage.start, costallocation = rec[costallocation]\n      | makeTimeseries {usage = sum(usage), start=start()}, from:toTimestamp($dt_timeframe_from), to:toTimestamp($dt_timeframe_to), time:usage.start, interval: 15m, by:{costallocation}\n      | fieldsAdd filter = costallocation\n      | fieldsAdd event.type = \"Metrics - Ingest \u0026 Process\"\n      | filter in(filter, {$Filter})\n]\n// \u003c---------THIS IS JUST FOR METRICS INGEST NORMALIZATION\n\n| lookup [\n   data json:$price_points\n], sourceField:event.type, lookupField:name, prefix: \"ratecard.\"\n| fieldsAdd isnull = isNull(adjusted_billable_total_per_costallocation)\n| fieldsAdd usage = if(isnull, usage, else: traces_usage)\n| fieldsAdd cost = usage[] * toDouble(ratecard.price) / toDouble(ratecard.priceUnit)\n| fieldsAdd cost = arraySum(cost)\n| fieldsAdd usage = arraySum(usage)\n//The summarize details would change based on intended tile\n\n| summarize {sum(usage), sum(cost)}, by:{event.type, filter}",
          "querySettings": {
